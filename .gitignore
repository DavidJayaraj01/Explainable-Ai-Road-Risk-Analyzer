# =============================================================================
# Git Ignore Configuration for XAI Road-Risk Intelligence
# =============================================================================

# Virtual Environments (DO NOT TRACK - Prevents thousands of library file warnings)
.venv/
venv/
ENV/
env/
.env
.env.*

# Python Bytecode, Caches & Testing
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# Editor & OS Artifacts
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Frontend Node Dependencies & Build Output
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Large Submission Archives & Compressed Files (Exceeds GitHub 100MB limit)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
xai-road-risk_submission.zip

# Raw Datasets (>150MB DfT counts and multi-year downloads)
# These are generated/downloaded via src/data/download_*.py
data/raw/
data/interim/
